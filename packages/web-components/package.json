{
    "name": "flyonui-web-components",
    "type": "module",
    "version": "0.0.0",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-web-components.git"
    },
    "browserslist": [
        "defaults and fully supports es6-module",
        "maintained node versions"
    ],
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/flyonui-web-components.js",
            "require": "./dist/flyonui-web-components.umd.cjs"
        }
    },
    "main": "./dist/flyonui-web-components.umd.cjs",
    "module": "./dist/flyonui-web-components.js",
    "types": "./dist/src/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "yarn concurrently \"yarn build:ui -w\" \"yarn build:types -w\" \"yarn alias:types -w\"",
        "build": "yarn build:ui && yarn build:types && yarn alias:types",
        "build:ui": "vite build",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.json",
        "alias:types": "tsc-alias -p tsconfig.json",
        "lint": "eslint . --fix",
        "publish": "yarn npm publish --access public",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "flyonui": "^2.4.1",
        "flyonui-vue": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.18.8",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "concurrently": "^9.2.1",
        "jsdom": "^26.1.0",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "vite": "^6.3.6",
        "vue": "^3.5.22",
        "vue-tsc": "^3.1.0"
    }
}
