{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "noEmit": false,
        "outDir": "dist"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "vite.config.ts"
    ]
}
