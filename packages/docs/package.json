{
    "name": "flyonui-vue-docs",
    "type": "module",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "scripts": {
        "dev": "vitepress",
        "preview": "vitepress preview",
        "build": "yarn type-check && vitepress build && cp -r assets/* ./.vitepress/dist/assets/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@stackblitz/sdk": "^1.11.0",
        "@vueuse/core": "^13.0.0",
        "flyonui": "^2.1.0",
        "flyonui-vue": "workspace:*",
        "highlight.js": "^10.7.3",
        "tailwindcss": "^4.0.17",
        "vue": "^3.5.13",
        "vue-code-highlighter": "^1.1.3",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify/vue": "^4.3.0",
        "@tailwindcss/postcss": "^4.0.17",
        "@types/node": "^22.13.13",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "jsdom": "^26.0.0",
        "postcss": "^8.5.3",
        "sass-embedded": "^1.86.0",
        "typescript": "^5.8.2",
        "vite": "^6.3.4",
        "vitepress": "2.0.0-alpha.4",
        "vue-tsc": "^2.2.8"
    }
}
