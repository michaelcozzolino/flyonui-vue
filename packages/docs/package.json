{
    "name": "flyonui-vue-docs",
    "type": "module",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "scripts": {
        "dev": "vitepress",
        "preview": "vitepress preview",
        "build": "yarn type-check && vitepress build && cp -r assets/* ./.vitepress/dist/assets/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@stackblitz/sdk": "^1.11.0",
        "@vueuse/core": "^13.0.0",
        "autoprefixer": "^10.4.19",
        "flyonui": "^1.3.0",
        "flyonui-vue": "workspace:*",
        "highlight.js": "^10.0.0",
        "tailwindcss": "^3.4.17",
        "vue": "^3.5.13",
        "vue-code-highlighter": "^1.1.2",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify/vue": "^4.2.0",
        "@types/node": "20.12.12",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "2.4.6",
        "@vue/tsconfig": "0.5.1",
        "jsdom": "^26.0.0",
        "postcss": "8.4.38",
        "sass-embedded": "^1.83.0",
        "typescript": "5.4.5",
        "vite": "^6.0.7",
        "vitepress": "1.5.0",
        "vue-tsc": "2.0.19"
    }
}
