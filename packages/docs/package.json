{
    "name": "flyonui-vue-docs",
    "type": "module",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "scripts": {
        "dev": "vitepress",
        "preview": "vitepress preview",
        "build": "yarn type-check && vitepress build && cp -r assets/* ./.vitepress/dist/assets/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:e2e": "yarn playwright install && npx playwright test EndToEnd",
        "test:e2e:update:snapshots": "yarn test:e2e -u",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@angular/common": "^22.1.7",
        "@angular/compiler": "^22.1.7",
        "@angular/core": "^22.1.7",
        "@angular/platform-browser": "^22.1.7",
        "@highlightjs/vue-plugin": "^2.1.2",
        "@stackblitz/sdk": "^1.11.1",
        "@vueuse/core": "^14.4.0",
        "flyonui": "^2.4.1",
        "flyonui-vue": "workspace:*",
        "flyonui-web-components": "workspace:*",
        "highlight.js": "^11.12.0",
        "pinia": "^3.0.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rxjs": "^7.8.2",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@iconify/vue": "^5.0.4",
        "@playwright/test": "~1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^20.19.43",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^29.1.1",
        "oxc-minify": "^0.155.0",
        "playwright": "~1.64.1",
        "postcss": "^8.5.31",
        "sass-embedded": "^1.106.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitepress": "2.0.0-alpha.21",
        "vitepress-plugin-llms": "^1.14.0",
        "vue-tsc": "^3.3.13"
    }
}
