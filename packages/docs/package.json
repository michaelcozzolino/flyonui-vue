{
    "name": "flyonui-vue-docs",
    "type": "module",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "scripts": {
        "dev": "vitepress",
        "preview": "vitepress preview",
        "build": "yarn type-check && vitepress build && cp -r assets/* ./.vitepress/dist/assets/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:e2e": "yarn playwright install && npx playwright test EndToEnd",
        "test:e2e:update:snapshots": "yarn test:e2e -u",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@highlightjs/vue-plugin": "^2.1.2",
        "@stackblitz/sdk": "^1.11.0",
        "@vueuse/core": "^14.2.1",
        "flyonui": "^2.4.1",
        "flyonui-vue": "workspace:*",
        "highlight.js": "^11.11.1",
        "pinia": "^3.0.4",
        "tailwindcss": "^4.1.18",
        "vue": "^3.5.28",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@iconify/vue": "^4.3.0",
        "@playwright/test": "~1.58.2",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/node": "^22.19.11",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "jsdom": "^26.1.0",
        "playwright": "~1.58.2",
        "postcss": "^8.5.6",
        "sass-embedded": "^1.97.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitepress": "2.0.0-alpha.16",
        "vue-tsc": "^3.2.4"
    }
}
