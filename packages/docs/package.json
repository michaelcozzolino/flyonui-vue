{
    "name": "flyonui-vue-docs",
    "type": "module",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "scripts": {
        "dev": "vitepress",
        "preview": "vitepress preview",
        "build": "yarn type-check && vitepress build && cp -r assets/* ./.vitepress/dist/assets/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:e2e": "npx playwright test EndToEnd",
        "test:e2e:update:snapshots": "yarn test:e2e -u",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@stackblitz/sdk": "^1.11.0",
        "@vueuse/core": "^13.6.0",
        "flyonui": "^2.4.0",
        "flyonui-vue": "workspace:*",
        "highlight.js": "^10.7.3",
        "pinia": "^3.0.3",
        "tailwindcss": "^4.1.12",
        "vue": "^3.5.18",
        "vue-code-highlighter": "^1.1.3",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@iconify/vue": "^4.3.0",
        "@playwright/test": "*",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/node": "^22.17.1",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "jsdom": "^26.1.0",
        "playwright": "*",
        "postcss": "^8.5.6",
        "sass-embedded": "^1.90.0",
        "typescript": "^5.9.2",
        "vite": "^6.3.5",
        "vitepress": "2.0.0-alpha.5",
        "vue-tsc": "^3.0.5"
    }
}
