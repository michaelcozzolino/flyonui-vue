{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "composite": true,
        "declarationMap": true,
        "outDir": "dist"
    },
    "vueCompilerOptions": {
        "vitePressExtensions": [".md"]
    },
    "include": [
        "./.vitepress/**/*",
        "./**/*.ts",
        "./**/*.d.ts",
        "./**/*.tsx",
        "./**/*.vue"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "vite.config.mts"
    ]
}
