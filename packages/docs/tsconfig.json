{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "experimentalDecorators": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "allowImportingTsExtensions": true,
        "outDir": "dist"
    },
    "vueCompilerOptions": {
        "vitePressExtensions": [".md"]
    },
    "include": [
        "./.vitepress/**/*",
        "./**/*.ts",
        "./**/*.d.ts",
        "./**/*.tsx",
        "./**/*.vue",
        "./Api/Lib/ComponentsApi.json"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "vite.config.ts"
    ]
}
