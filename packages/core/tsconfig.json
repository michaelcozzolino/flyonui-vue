{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "composite": true,
        "rootDir": "./src",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "declarationMap": true,
        "noEmit": false,
        "outDir": "dist-vue"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue"
    ],
    "exclude": [
        "node_modules",
        "dist-vue",
        "dist-ce.vue",
        "vite.config.vue.mts",
        "vite.config.ce.vue.mts",
        "tests/**/*.ts",
        "src/Scripts/**/*.ts"
    ]
}
