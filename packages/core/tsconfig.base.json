{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "paths": {
            "@/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "esModuleInterop": true
    }
}
