{
    "name": "flyonui-vue",
    "type": "module",
    "version": "1.0.0-alpha.7",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/flyonui-vue.js",
            "require": "./dist/flyonui-vue.umd.cjs"
        },
        "./index.css": {
            "import": "./dist/index.css",
            "require": "./dist/index.css"
        }
    },
    "main": "./dist/flyonui-vue.umd.cjs",
    "module": "./dist/flyonui-vue.js",
    "types": "./dist/src/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "yarn concurrently \"yarn build:ui -w\" \"yarn build:types -w\" \"yarn alias:types -w\"",
        "build": "yarn build:ui && yarn build:types && yarn alias:types",
        "build:ui": "vite build",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.json",
        "alias:types": "tsc-alias -p tsconfig.json",
        "lint": "eslint . --fix",
        "publish": "yarn npm publish --access public",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "peerDependencies": {
        "@iconify/vue": "^4",
        "flyonui": "^2",
        "tailwindcss": "^4",
        "vue": "^3",
        "vue-router": "^4"
    },
    "dependencies": {
        "@vueuse/components": "^13.0.0",
        "@vueuse/core": "^13.0.0",
        "@vueuse/motion": "^3.0.3"
    },
    "devDependencies": {
        "@iconify/vue": "^4.3.0",
        "@tailwindcss/vite": "^4.0.17",
        "@types/node": "^22.13.13",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "concurrently": "^9.1.2",
        "jsdom": "^26.0.0",
        "rollup-plugin-visualizer": "^5.14.0",
        "sass-embedded": "^1.86.0",
        "tailwindcss": "^4.0.17",
        "tsc-alias": "^1.8.11",
        "typescript": "^5.8.2",
        "vite": "^6.2.6",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "vue-tsc": "^2.2.8"
    }
}
