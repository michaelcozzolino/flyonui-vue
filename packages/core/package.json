{
    "name": "flyonui-vue",
    "type": "module",
    "version": "2.0.0",
    "author": "Michael Cozzolino",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcozzolino/flyonui-vue.git"
    },
    "browserslist": [
        "defaults and fully supports es6-module",
        "maintained node versions"
    ],
    "exports": {
        ".": {
            "types": "./dist-vue/index.d.ts",
            "import": "./dist-vue/flyonui-vue.js",
            "require": "./dist-vue/flyonui-vue.umd.cjs",
            "default": "./dist-vue/index.d.ts"
        },
        "./ce": {
            "types": "./dist-ce.vue/index.d.ts",
            "import": "./dist-ce.vue/flyonui-vue.js",
            "require": "./dist-ce.vue/flyonui-vue.umd.cjs"
        },
        "./*.css": "./dist-vue/*.css"
    },
    "files": [
        "dist-vue",
        "dist-ce.vue"
    ],
    "scripts": {
        "build": "yarn build:vue && yarn build:ce.vue",
        "dev:vue": "yarn concurrently \"yarn build:vue:ui -w\" \"yarn build:vue:types -w\" \"yarn alias:vue:types -w\"",
        "build:vue": "yarn build:vue:ui && yarn build:vue:types && yarn alias:vue:types",
        "build:vue:ui": "vite build -c vite.config.vue.mts",
        "build:vue:types": "vue-tsc --emitDeclarationOnly -p tsconfig.json --outDir dist-vue",
        "alias:vue:types": "tsc-alias -p tsconfig.json --outDir dist-vue",
        "dev:ce.vue": "yarn concurrently \"yarn build:ce.vue:ui -w\" \"yarn build:ce.vue:types -w\" \"yarn alias:ce.vue:types -w\"",
        "build:ce.vue": "yarn build:ce.vue:ui && yarn build:ce.vue:types && yarn alias:ce.vue:types",
        "build:ce.vue:ui": "vite build -c vite.config.ce.vue.mts",
        "build:ce.vue:types": "vue-tsc --emitDeclarationOnly -p tsconfig.json --outDir dist-ce.vue",
        "alias:ce.vue:types": "tsc-alias -p tsconfig.json --outDir dist-ce.vue",
        "lint": "eslint . --fix",
        "publish": "yarn npm publish --access public",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit -p tsconfig.json"
    },
    "peerDependencies": {
        "@iconify/vue": "^4",
        "flyonui": "^2",
        "tailwindcss": "^4",
        "vue": "^3",
        "vue-router": "^4"
    },
    "peerDependenciesMeta": {
        "@iconify/vue": {
            "optional": true
        },
        "vue-router": {
            "optional": true
        }
    },
    "dependencies": {
        "@floating-ui/vue": "^1.1.6",
        "@vueuse/components": "^13.0.0",
        "@vueuse/core": "^13.0.0",
        "@vueuse/head": "^2.0.0",
        "@vueuse/motion": "^3.0.3",
        "deepmerge": "^4.3.1"
    },
    "devDependencies": {
        "@iconify/vue": "^4.3.0",
        "@tailwindcss/vite": "^4.0.17",
        "@types/node": "^22.13.13",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "concurrently": "^9.1.2",
        "jsdom": "^26.0.0",
        "rollup-plugin-visualizer": "^5.14.0",
        "sass-embedded": "^1.86.0",
        "tailwindcss": "^4.0.17",
        "tsc-alias": "^1.8.11",
        "typescript": "^5.8.2",
        "vite": "^6.3.4",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "vue-tsc": "^2.2.8"
    }
}
