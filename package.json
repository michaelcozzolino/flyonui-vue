{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "yarn@4.6.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dependency-upgrade": "npx yarn-upgrade-all",
        "dev": "yarn concurrently \"yarn workspace flyonui-vue dev:vue\" \"yarn workspace flyonui-vue-docs dev\"",
        "build": "yarn workspaces foreach -Apt run build",
        "lint": "yarn workspaces foreach -Apt run lint",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "audit": "yarn npm audit --all",
        "generate-components-api": "node scripts/GenerateComponentsApi.mts"
    },
    "dependencies": {
        "change-case": "^5.4.4"
    },
    "devDependencies": {
        "@michaelcozzolino/eslint-config": "^1.1.2",
        "@playwright/test": "~1.47.2",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitest/browser": "^3.1.4",
        "@vitest/coverage-v8": "^3.1.4",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.1.2",
        "eslint": "^9.23.0",
        "playwright": "~1.47.2",
        "typescript": "^5.8.2",
        "vite": "^6.3.5",
        "vitest": "^3.1.4",
        "vue": "^3.5.18",
        "vue-component-meta": "^3.0.5",
        "vue-component-type-helpers": "3.0.1"
    },
    "resolutions": {
        "vite": "6.3.5",
        "vue": "3.5.18",
        "typescript": "5.8.2"
    }
}
