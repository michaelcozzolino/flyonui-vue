{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "yarn@4.6.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dependency-upgrade": "npx yarn-upgrade-all",
        "dev": "yarn concurrently \"yarn workspace flyonui-vue dev:vue\" \"yarn workspace flyonui-vue-docs dev\"",
        "build": "yarn workspaces foreach -Apt run build",
        "lint": "yarn workspaces foreach -Apt run lint",
        "test": "vitest run",
        "preview:docs": "yarn workspace flyonui-vue-docs preview",
        "test:e2e": "yarn workspace flyonui-vue-docs test:e2e",
        "test-coverage": "vitest run --coverage",
        "audit": "yarn npm audit --all",
        "update:dependencies": "yarn workspaces foreach -Apt exec npx npm-check-updates -u -t minor",
        "upgrade:dependencies": "yarn workspaces foreach -Apt exec npm-check-updates -u -t latest",
        "core:version": "yarn workspace flyonui-vue-scripts get:core:version"
    },
    "dependencies": {
        "change-case": "^5.4.4"
    },
    "devDependencies": {
        "@michaelcozzolino/eslint-config": "^1.1.3",
        "@vitest/browser": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.2.1",
        "eslint": "^9.37.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4",
        "vue-tsc": "^3.1.1"
    },
    "resolutions": {
        "@iconify/vue": "^4.3.0",
        "@types/node": "^22.19.11",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "@vueuse/core": "^14.2.1",
        "concurrently": "^9.2.1",
        "flyonui": "^2.4.1",
        "flyonui-vue": "workspace:*",
        "jsdom": "^26.1.0",
        "sass-embedded": "^1.97.3",
        "tailwindcss": "^4.1.18",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^3.2.4",
        "vue": "^3.5.28",
        "vue-router": "^4.6.4",
        "vue-tsc": "^3.2.4"
    }
}
