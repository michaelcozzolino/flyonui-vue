{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "yarn@4.13.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "load:docs-icons": "yarn workspace flyonui-vue-scripts codex:load:docs-icons",
        "dependency-upgrade": "npx yarn-upgrade-all",
        "dev": "yarn concurrently \"yarn workspace flyonui-vue dev:vue\" \"yarn workspace flyonui-vue-docs dev\"",
        "build": "yarn workspaces foreach -Apt run build",
        "lint": "yarn workspaces foreach -Apt run lint",
        "test": "vitest run",
        "preview:docs": "yarn workspace flyonui-vue-docs preview",
        "test:e2e": "yarn workspace flyonui-vue-docs test:e2e",
        "test-coverage": "vitest run --coverage",
        "audit": "yarn npm audit --all",
        "update:dependencies": "yarn workspaces foreach -Apt exec npx npm-check-updates -u -t minor",
        "upgrade:dependencies": "yarn workspaces foreach -Apt exec npx npm-check-updates -u -t latest",
        "core:version": "yarn workspace flyonui-vue-scripts get:core:version"
    },
    "dependencies": {
        "change-case": "^5.4.4"
    },
    "devDependencies": {
        "@michaelcozzolino/eslint-config": "^1.1.3",
        "@vitest/browser": "^4.1.2",
        "@vitest/coverage-v8": "^4.1.2",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.2.1",
        "eslint": "^9.35.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2",
        "vue-tsc": "^3.2.6"
    },
    "resolutions": {
        "@iconify/vue": "^5.0.0",
        "@types/node": "^25.5.0",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "@vueuse/core": "^14.2.1",
        "concurrently": "^9.2.1",
        "flyonui": "^2.4.1",
        "flyonui-vue": "workspace:*",
        "jsdom": "^29.0.1",
        "sass-embedded": "^1.98.0",
        "tailwindcss": "^4.2.2",
        "tsc-alias": "^1.8.16",
        "typescript": "^6.0.2",
        "vite": "^8.0.3",
        "vitest": "^4.1.2",
        "vue": "^3.5.31",
        "vue-router": "^5.0.4",
        "vue-tsc": "^3.2.6"
    }
}
